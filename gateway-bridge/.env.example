# 건물(Concentrator)별로 하나씩 이 파일을 채워서 각 PC/장치에 배치합니다.

CONCENTRATOR_ID=1CORPS-B3-CONC1

# 개발 중에는 로컬 백엔드(4000), 운영에서는 4001 또는 실제 중앙서버 주소
CENTRAL_API_URL=http://127.0.0.1:4000
BRIDGE_API_KEY=dev-bridge-key-change-me

# Windows에서는 COM3, COM4 형식. Device Manager에서 확인.
SERIAL_PORT=COM3
BAUD_RATE=19200

# 중앙서버 연결이 끊겼을 때 이벤트를 임시로 쌓아두는 로컬 큐 DB
LOCAL_QUEUE_DB=./local_queue.sqlite3

# 몇 초 간격으로 중앙서버 재연결을 시도할지
RETRY_INTERVAL_SEC=10

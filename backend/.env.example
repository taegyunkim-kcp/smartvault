# 이 파일을 복사해서 .env.development / .env.production 두 벌을 만드세요.
# 실제 값이 든 .env.* 파일은 절대 git에 커밋하지 않습니다 (.gitignore에 이미 포함됨).

NODE_ENV=development

# --- 서버 ---
# 개발: 4000 / 운영: 4001  (동시에 켜져 있어도 충돌 안 나게 반드시 다르게)
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- DB ---
# 개발: docker-compose.dev.yml 의 포트(3307), 운영: docker-compose.prod.yml 의 포트(3308)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=smartvault_dev
DB_PASSWORD=devpass_change_me
DB_NAME=smartvault_dev

# --- 인증 ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# --- 게이트웨이 브리지 인증 (Concentrator → 백엔드) ---
# gateway-bridge 쪽 .env 의 BRIDGE_API_KEY 와 동일한 값이어야 함
BRIDGE_API_KEYS=dev-bridge-key-change-me
